---
import { settings } from "../lib/site.mjs";
const here = Astro.url.pathname;
const links = [["Journal", "/journal/"], ["Shop", "/shop/"], ["About", "/about/"]];
---
<div class="gingham-strip" aria-hidden="true"></div>
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label={`${settings.siteName}, home`}>
      <span class="wordmark__plans">Plans</span> <span class="wordmark__past">Past</span> <span class="wordmark__five">Five</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {links.map(([label, href]) => (
          <li><a href={href} aria-current={here.startsWith(href) ? "page" : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
