---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { imageUrl, categorySlug } from "../../lib/catalog.mjs";
import { CATEGORIES } from "../../lib/schemas.mjs";

const articles = (await getCollection("articles", (a) => a.data.status === "published")).sort(
  (a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt),
);
const [lead, ...rest] = articles;
const cats = CATEGORIES.filter((c) => articles.some((a) => a.data.category === c));
---
<Base title="The Journal" description="Hobbies worth trying, plans worth making and the occasional glue-related opinion: stories for life after five." path="/journal/" image={lead ? imageUrl(lead.data.hero.image) : undefined}>
  <div class="wrap page-head">
    <p class="eyebrow">The Journal</p>
    <h1>Stories for life after five</h1>
    <p class="page-head__dek">Hobbies worth trying, plans worth making, and the occasional glue-related opinion.</p>
    {cats.length > 0 && (
      <nav class="chips" aria-label="Categories">
        <ul class="plain">{cats.map((c) => <li><a href={`/journal/category/${categorySlug(c)}/`}>{c}</a></li>)}</ul>
      </nav>
    )}
  </div>
  <div class="wrap section section--tight">
    {lead && <ArticleCard entry={lead} lead heading="h2" />}
    {rest.length > 0 && <div class="card-grid">{rest.map((e) => <ArticleCard entry={e} heading="h2" />)}</div>}
  </div>
</Base>
