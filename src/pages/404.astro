---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page is not here, but plenty of good plans are." path="/404.html">
  <div class="wrap page-head page-head--center">
    <p class="eyebrow">404</p>
    <h1>This page has gone for the weekend</h1>
    <p class="page-head__dek">We could not find what you were looking for. Try the Journal, or head back home.</p>
    <p class="hero__actions"><a class="button" href="/journal/">Read the Journal</a> <a class="button button--ghost" href="/">Back home</a></p>
  </div>
</Base>
