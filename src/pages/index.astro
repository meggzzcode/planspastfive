---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { settings, siteImage, abs } from "../lib/site.mjs";
import { shopGroups, imageUrl, articlesUsingProduct } from "../lib/catalog.mjs";
import { disclosureHtml } from "../lib/render-product.mjs";

const articles = (await getCollection("articles", (a) => a.data.status === "published")).sort(
  (a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt),
);
const featured = articles.filter((a) => a.data.featured).slice(0, 3);
const latest = articles.filter((a) => !a.data.featured).slice(0, 4);
const [lead, ...rest] = latest;
const products = (await getCollection("products")).map((p) => p.data);
const groups = shopGroups(products, settings.launchMode);
const usedIn = articlesUsingProduct(articles.map((a) => ({ id: a.id, title: a.data.title, picks: a.data.picks, body: a.body })), new Map(products.map((p) => [p.id, p])), settings.launchMode);
const picks = groups.flatMap((g) => g.products.slice(0, 1).map((p) => ({ ...p, group: g }))).slice(0, 3);
const hero = siteImage("weekend-picnic");
const cozy = siteImage("cozy-corner");
const jsonLd = [{ "@context": "https://schema.org", "@type": "WebSite", name: settings.siteName, url: abs("/"), description: settings.tagline }];
---
<Base home title={settings.tagline} description="Your next favorite thing starts here. Fun hobbies, pretty little projects and thoughtfully chosen supplies for making the most of life after five." path="/" image={hero.src} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">An independent lifestyle journal</p>
        <h1 id="hero-h" class="hero__title">Plans Past <em>Five.</em></h1>
        <p class="hero__sub">Making a life, not just a living.</p>
        <p class="hero__lede">Your next favorite thing starts here. Discover fun hobbies, pretty little projects and thoughtfully chosen supplies for making the most of life after five.</p>
        <p class="hero__actions">
          <a class="button" href="/journal/">Explore the Journal</a>
          {groups.length > 0 && <a class="button button--ghost" href="/shop/">Shop Our Favorites</a>}
        </p>
      </div>
      <figure class="postcard">
        <span class="tape" aria-hidden="true"></span>
        <img src={hero.src} alt={hero.alt} width="1152" height="896" fetchpriority="high" decoding="async" />
        <figcaption><span class="hand">saturday, with a storyline.</span><span class="illus">{hero.caption}</span></figcaption>
      </figure>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section section--flush" aria-labelledby="featured-h">
      <div class="wrap">
        <div class="section-head"><h2 id="featured-h">Featured experiences</h2></div>
        <ul class="plain feature-grid">
          {featured.map((e) => (
            <li class="feature">
              <a class="feature__media" href={`/journal/${e.id}/`} tabindex="-1" aria-hidden="true"><img src={imageUrl(e.data.hero.image)} alt="" loading="lazy" decoding="async" width="1152" height="896" /></a>
              <p class="eyebrow">{e.data.category}</p>
              <h3 class="feature__title"><a href={`/journal/${e.id}/`}>{e.data.title}</a></h3>
              <p>{e.data.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {lead && (
    <section class="section" aria-labelledby="latest">
      <div class="wrap">
        <div class="section-head">
          <h2 id="latest">Latest from the Journal</h2>
          <a class="more" href="/journal/">All stories <span aria-hidden="true">&rarr;</span></a>
        </div>
        <ArticleCard entry={lead} lead />
        {rest.length > 0 && <div class="card-grid">{rest.map((e) => <ArticleCard entry={e} />)}</div>}
      </div>
    </section>
  )}

  {picks.length > 0 && (
    <section class="band band--butter" aria-labelledby="shop-teaser">
      <div class="wrap">
        <div class="section-head">
          <h2 id="shop-teaser">A little shopping inspiration</h2>
          <a class="more" href="/shop/">The whole shop <span aria-hidden="true">&rarr;</span></a>
        </div>
        <p class="section-lede">A short shelf, chosen with care. Every item is checked against its Amazon listing before it gets a place here.</p>
        <Fragment set:html={disclosureHtml(settings)} />
        <ul class="teaser-grid plain">
          {picks.map((p) => (
            <li class="teaser">
              <p class="eyebrow">{p.group.plain}</p>
              <h3>{p.name}</h3>
              <p class="teaser__brand">{p.brand}</p>
              <p>{p.descriptionOriginal}</p>
              <p class="teaser__links">
                <a class="more" href={`/shop/#${p.group.id}`}>Shop {p.group.label} <span aria-hidden="true">&rarr;</span></a>
                {(usedIn.get(p.id) || []).slice(0, 1).map((a) => <a class="more" href={`/journal/${a.id}/`}>See where it appears<span class="sr-only">: {a.title}</span></a>)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band band--strawberry" aria-labelledby="story">
    <div class="wrap band__grid">
      <div>
        <p class="eyebrow">Our story</p>
        <h2 id="story" class="band__quote">Your career can be a big part of your life without being your whole life.</h2>
        <p>That is the whole idea. Plans Past Five is an independent little magazine about what happens once the laptop closes: the junk journal on a Tuesday, the mahjong night with too many strawberries, the first gloriously lopsided pot. We write the plans, and we point to the supplies that make them easier.</p>
        <p>Shopping is tucked in where it genuinely helps, and always labelled. <a class="more" href="/about/">How we work <span aria-hidden="true">&rarr;</span></a></p>
      </div>
      <figure class="frame">
        <img src={cozy.src} alt={cozy.alt} loading="lazy" decoding="async" width="1600" height="1205" />
        <figcaption class="illus-cap">{cozy.caption}</figcaption>
      </figure>
    </div>
  </section>
</Base>
