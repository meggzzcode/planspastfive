---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { settings } from "../lib/site.mjs";
import { shopGroups } from "../lib/catalog.mjs";
import { productCardHtml, disclosureHtml } from "../lib/render-product.mjs";

const products = (await getCollection("products")).map((p) => p.data);
const groups = shopGroups(products);
---
<Base title="The Shop" description="A short, curated list of things worth buying for the hobbies and plans in the Journal. Each one is checked against its Amazon listing." path="/shop/">
  <div class="wrap page-head">
    <p class="eyebrow">The Shop</p>
    <h1>A short list, chosen with care</h1>
    <p class="page-head__dek">Not everything. Just the few things we would point a friend to, each one checked against its Amazon listing, with an honest note on who it suits and what to know first.</p>
  </div>
  <div class="wrap section section--tight">
    {groups.length === 0 ? (
      <p>The shop is being stocked. Check back soon.</p>
    ) : (
      <>
        <Fragment set:html={disclosureHtml(settings)} />
        {groups.length > 1 && (
          <nav class="chips" aria-label="Shop sections">
            <ul class="plain">{groups.map((g) => <li><a href={`#${g.id}`}>{g.label}</a></li>)}</ul>
          </nav>
        )}
        {groups.map((g) => (
          <section class="shop-group" id={g.id} aria-labelledby={`h-${g.id}`}>
            <h2 id={`h-${g.id}`}>{g.label}</h2>
            <div class="pick-list pick-list--grid">
              {g.products.map((p) => <Fragment set:html={productCardHtml(p, settings)} />)}
            </div>
          </section>
        ))}
      </>
    )}
  </div>
</Base>
