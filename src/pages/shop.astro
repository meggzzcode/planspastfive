---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { settings, images } from "../lib/site.mjs";
import { shopGroups } from "../lib/catalog.mjs";
import { productCardHtml, disclosureHtml } from "../lib/render-product.mjs";
import { imageUrl } from "../lib/catalog.mjs";
import { captionFor } from "../lib/images.mjs";

const products = (await getCollection("products")).map((p) => p.data);
const groups = shopGroups(products, settings.launchMode);
---
<Base title="The Shop" description="Your shortcut to a new favorite hobby: pretty journaling supplies, clay and mahjong essentials, picked to make getting started the fun part." path="/shop/">
  <div class="wrap page-head">
    <p class="eyebrow">The Shop</p>
    <h1>The Good Stuff, Already Found</h1>
    <p class="page-head__dek">Consider this your shortcut to a new favorite hobby. From pretty journaling supplies to everything you need for a creative afternoon, we&rsquo;ve picked useful, affordable finds that make getting started feel like the fun part.</p>
  </div>
  <div class="wrap section section--tight">
    {groups.length === 0 ? (
      <p>The shop is being stocked. Check back soon.</p>
    ) : (
      <>
        <Fragment set:html={disclosureHtml(settings)} />
        {groups.length > 1 && (
          <nav class="chips" aria-label="Shop sections">
            <ul class="plain">{groups.map((g) => <li><a href={`#${g.id}`}>{g.label}</a></li>)}</ul>
          </nav>
        )}
        {groups.map((g) => {
          const rec = g.image && images[g.image]?.rightsStatus === "approved" ? images[g.image] : null;
          const card = (p) => <Fragment set:html={productCardHtml(p, settings, { ctx: { page: "shop" }, placement: "shop", images })} />;
          const entry = (p) => {
            const alts = g.alternatives.get(p.id) || [];
            return alts.length === 0 ? card(p) : (
              <div class="choice-set">
                {card(p)}
                <p class="choice-set__note">Or choose one of these instead. You only need one.</p>
                {alts.map(card)}
              </div>
            );
          };
          return (
          <section class="shop-group" id={g.id} aria-labelledby={`h-${g.id}`}>
            <div class={rec ? "shop-group__head shop-group__head--with-image" : "shop-group__head"}>
              {rec && <figure class="shop-group__image"><img src={imageUrl(rec.file)} alt={rec.alt} loading="lazy" decoding="async" /><figcaption>{captionFor(rec)}</figcaption></figure>}
              <div>
                <h2 id={`h-${g.id}`}>{g.label}</h2>
                <p class="shop-group__plain">{g.plain}</p>
              </div>
            </div>
            {g.extras.length > 0 && <h3 class="shop-group__tier">Start here</h3>}
            <div class="pick-list pick-list--grid">{g.start.map(entry)}</div>
            {g.extras.length > 0 && (<>
              <h3 class="shop-group__tier">{g.extrasLabel}</h3>
              <div class="pick-list pick-list--grid">{g.extras.map(entry)}</div>
            </>)}
          </section>
          );
        })}
      </>
    )}
  </div>
</Base>
